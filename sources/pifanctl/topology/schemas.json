{
  "CoolingZone": {
    "type": "object",
    "properties": {
      "nodeSelector": {
        "type": "object",
        "properties": {
          "matchLabels": {
            "type": "object",
            "maxProperties": 64,
            "additionalProperties": {
              "type": "string",
              "maxLength": 63
            }
          },
          "matchExpressions": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 317
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "In",
                    "NotIn",
                    "Exists",
                    "DoesNotExist"
                  ]
                },
                "values": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "type": "string",
                    "maxLength": 63
                  }
                }
              },
              "required": [
                "key",
                "operator"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "nodeNames": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1024,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        }
      },
      "fanRefs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        }
      },
      "telemetry": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "prometheus",
              "local"
            ]
          },
          "prometheusURL": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https?://[^\\s]+$"
          },
          "maxSampleAgeSeconds": {
            "type": "integer",
            "minimum": 5,
            "maximum": 300,
            "default": 30
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "fanRefs",
      "telemetry"
    ],
    "additionalProperties": false,
    "oneOf": [
      {
        "required": [
          "nodeSelector"
        ]
      },
      {
        "required": [
          "nodeNames"
        ]
      }
    ]
  },
  "Fan": {
    "type": "object",
    "properties": {
      "nodeName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
      },
      "hardware": {
        "type": "object",
        "properties": {
          "rpigpio": {
            "type": "object",
            "properties": {
              "pin": {
                "type": "integer",
                "minimum": 0,
                "maximum": 27
              },
              "frequencyHz": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000,
                "default": 1000
              }
            },
            "required": [
              "pin"
            ],
            "additionalProperties": false
          },
          "sysfs": {
            "type": "object",
            "properties": {
              "chip": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "channel": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "frequencyHz": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000,
                "default": 1000
              }
            },
            "required": [
              "chip",
              "channel"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "rpigpio"
            ]
          },
          {
            "required": [
              "sysfs"
            ]
          }
        ]
      },
      "control": {
        "type": "object",
        "properties": {
          "curve": {
            "type": "object",
            "properties": {
              "temperatureLow": {
                "type": "number",
                "minimum": 0,
                "maximum": 120,
                "default": 50
              },
              "temperatureHigh": {
                "type": "number",
                "minimum": 0,
                "maximum": 120,
                "default": 70
              },
              "dutyIdle": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "default": 0
              },
              "dutyStart": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "default": 30
              },
              "dutyMax": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "default": 100
              },
              "dutyDownStep": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "default": 5
              },
              "temperatureHysteresis": {
                "type": "number",
                "minimum": 0,
                "maximum": 120,
                "default": 5
              }
            },
            "default": {
              "temperatureLow": 50,
              "temperatureHigh": 70,
              "dutyIdle": 0,
              "dutyStart": 30,
              "dutyMax": 100,
              "dutyDownStep": 5,
              "temperatureHysteresis": 5
            },
            "additionalProperties": false
          },
          "refreshIntervalSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60,
            "default": 5
          },
          "failsafeDuty": {
            "type": "number",
            "enum": [
              100
            ],
            "default": 100
          },
          "exitDuty": {
            "type": "number",
            "enum": [
              100
            ],
            "default": 100
          }
        },
        "default": {},
        "additionalProperties": false
      }
    },
    "required": [
      "nodeName",
      "hardware"
    ],
    "additionalProperties": false
  }
}
