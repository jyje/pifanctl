{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "operatorId",
    "replicas",
    "agent"
  ],
  "properties": {
    "input": {"not": {}},
    "operatorId": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "maxLength": 40
    },
    "replicas": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "agent": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "managed",
            "reuse"
          ]
        },
        "interval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "mode",
        "interval"
      ]
    },
    "extraResources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["apiVersion", "kind", "metadata"],
        "properties": {
          "apiVersion": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "metadata": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
